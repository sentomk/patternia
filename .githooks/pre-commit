#!/usr/bin/env bash
set -euo pipefail

# Formats staged C/C++ files with the pinned clang-format from
# .tools/venv (installed on first use) and re-stages them.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python="$(command -v python3 || command -v python || true)"
if [ -z "$python" ]; then
  echo "pre-commit: python not found in PATH."
  echo "Install Python 3 or bypass with --no-verify."
  exit 1
fi

exec "$python" scripts/format.py --fix --staged
